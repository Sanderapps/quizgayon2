# Exemplo de variáveis de ambiente para desenvolvimento local
# Copie este arquivo para .env e preencha com seus valores

# URL de conexão com PostgreSQL
# Opção 1: Neon (recomendado para desenvolvimento)
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Opção 2: PostgreSQL local
# DATABASE_URL=postgresql://postgres:senha@localhost:5432/quizgayon

# Ambiente de execução (development ou production)
NODE_ENV=development

# Porta do servidor (opcional, padrão: 3000)
PORT=3000

# Senha do painel admin
ADMIN_PASSWORD=@dm1n321

# Chave de admin da rádio (para acessar /admin-radio)
RADIO_ADMIN_KEY=sua_chave_secreta_aqui

# ============================================
# VARIÁVEIS INJETADAS AUTOMATICAMENTE PELO RAILWAY
# (Não é necessário configurar manualmente no Railway)
# ============================================
# PGHOST=postgres.railway.internal
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=senha_gerada_automaticamente
# PGDATABASE=railway
